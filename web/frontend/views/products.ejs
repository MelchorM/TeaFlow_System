<%- include('partials/header',{title}) %>
<div class="page-heading"><p class="eyebrow">OWNER WORKSPACE</p><h1>Products & recipes</h1><p>Manage drinks, size prices, toppings, and ingredient quantities for each size.</p></div>
<% if(sampleRecipes) { %><div class="notice warning">The initial recipes use sample portions. Confirm actual recipes with BESTBREW. Recipe edits apply to new orders; submitted orders retain their saved ingredient requirements.</div><% } %>
<section class="panel management-section"><h2>Add a drink</h2><form action="/staff/products" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input class="form-control" name="name" maxlength="100" required></label><label>Category<input class="form-control" name="category" maxlength="100" required></label><label>Small (₱)<input class="form-control" type="number" name="small" min="0" step="0.01" max="999999" required></label><label>Large (₱)<input class="form-control" type="number" name="large" min="0" step="0.01" max="999999" required></label><button class="button" type="submit">Add drink</button></form></section>
<section class="management-section"><h2>Toppings</h2><p class="muted">Initial prices are temporary. Set each topping’s actual price and ingredient amount.</p><div class="inventory-grid"><% for(const addon of addons) { %><div class="panel"><h3><%= addon.name %></h3><form action="/staff/addons/<%= addon.id %>" method="post" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field-pair"><label>Price per drink (₱)<input class="form-control" type="number" name="price" value="<%= (addon.price_cents/100).toFixed(2) %>" min="0" max="999999" step="0.01" required></label><label>Availability<select class="form-select" name="active"><option value="1" <%= addon.active?'selected':'' %>>Available</option><option value="0" <%= !addon.active?'selected':'' %>>Unavailable</option></select></label></div><label>Ingredient<select class="form-select" name="ingredient_id"><% for(const ingredient of ingredients) { %><option value="<%= ingredient.id %>" <%= ingredient.id===addon.ingredient_id?'selected':'' %>><%= ingredient.name %> (<%= ingredient.unit %>)</option><% } %></select></label><label>Ingredient amount per drink<input class="form-control" type="number" name="amount" value="<%= addon.amount_milli/1000 %>" min="0.001" max="999999" step="0.001" required></label><button class="button secondary full" type="submit">Save topping</button></form></div><% } %></div></section>
<section class="management-section"><h2>Drink catalog</h2><% for(const product of products) { %><details class="panel product-editor"><summary><strong><%= product.name %></strong><span><%= product.category %> · <%= product.active?'Available':'Unavailable' %></span></summary>
  <form action="/staff/products/<%= product.id %>" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input class="form-control" name="name" value="<%= product.name %>" maxlength="100" required></label><label>Category<input class="form-control" name="category" value="<%= product.category %>" maxlength="100" required></label><% for(const variant of product.variants) { %><label><%= variant.size %> (₱)<input class="form-control" type="number" name="<%= variant.size.toLowerCase() %>" value="<%= (variant.price_cents/100).toFixed(2) %>" min="0" max="999999" step="0.01" required></label><% } %><label>Availability<select class="form-select" name="active"><option value="1" <%= product.active?'selected':'' %>>Available</option><option value="0" <%= !product.active?'selected':'' %>>Unavailable</option></select></label><button class="button" type="submit">Save drink</button></form>
  <div class="recipe-grid"><% for(const variant of product.variants) { %><div><h3><%= variant.size %> recipe</h3><ul class="recipe-list"><% for(const recipe of variant.recipes) { %><li><%= recipe.name %> (<%= recipe.option_basis %>) <strong><%= stock(recipe.amount_milli) %> <%= recipe.unit %></strong></li><% } %></ul>
  <form method="post" action="/staff/recipes/<%= variant.id %>" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Ingredient<select class="form-select" name="ingredient_id"><% for(const ingredient of ingredients) { %><option value="<%= ingredient.id %>"><%= ingredient.name %> (<%= ingredient.unit %>)</option><% } %></select></label>
    <label>Amount per drink<input class="form-control" type="number" name="amount" min="0" max="999999" step="0.001" required></label>
    <label>Quantity rule<select class="form-select" name="option_basis"><option value="fixed">Fixed amount</option><option value="sugar">Scale with sugar level</option><option value="ice">Scale with ice level</option></select></label>
    <p class="muted">Use the stock unit. Sugar amounts are entered for 100%; ice amounts for regular ice. Light ice uses half. Enter 0 to remove the ingredient.</p>
    <button class="button secondary" type="submit">Save ingredient amount</button>
  </form></div><% } %></div>
  <form action="/staff/products/<%= product.id %>" method="post" data-confirm="Remove this drink from the menu? Existing order records will be kept."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="delete"><button class="text-button danger" type="submit">Delete product from menu</button></form>
</details><% } %></section>
<%- include('partials/footer') %>
