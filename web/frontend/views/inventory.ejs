<%- include('partials/header',{title}) %>
<div class="page-heading"><p class="eyebrow">STOCK & INGREDIENTS</p><h1>Inventory</h1><p>Record restocks and stock counts. Every adjustment is kept in the stock history.</p></div>
<% if(sampleRecipes) { %><div class="notice warning">Sample recipe quantities are in use. Enter BESTBREW’s actual recipes and opening stock before using this system for shop service.</div><% } %>
<div class="inventory-grid"><% for(const ingredient of ingredients) { %><article class="panel"><div class="order-card-heading"><h3><%= ingredient.name %></h3><% if(ingredient.stock_milli<=ingredient.low_milli) { %><span class="order-status unpaid">Low stock</span><% } %></div><p class="stock-number"><%= stock(ingredient.stock_milli) %> <small><%= ingredient.unit %></small></p>
<form method="post" action="/staff/inventory/<%= ingredient.id %>" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field-pair"><label>Adjustment<select class="form-select" name="kind"><option value="restock">Add stock</option><option value="count">Set counted stock</option></select></label><label>Quantity (<%= ingredient.unit %>)<input class="form-control" type="number" name="quantity" min="0" max="999999" step="0.001" required></label></div><label>Low-stock limit<input class="form-control" type="number" name="low_limit" min="0" max="999999" step="0.001" value="<%= ingredient.low_milli/1000 %>" required></label><label>Reason<input class="form-control" name="reason" minlength="3" maxlength="200" placeholder="e.g. morning restock" required></label><button class="button secondary full" type="submit">Save adjustment</button></form></article><% } %></div>
<section class="panel management-section"><h2>Add an ingredient</h2><form action="/staff/ingredients" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input class="form-control" name="name" maxlength="100" required></label><label>Stock unit<input class="form-control" name="unit" placeholder="g, ml, pieces…" maxlength="30" required></label><button class="button" type="submit">Add ingredient</button></form></section>
<section class="panel management-section"><h2>Recent stock movements</h2><div class="table-responsive"><table class="table"><thead><tr><th>Time</th><th>Ingredient</th><th>Change</th><th>Reason</th></tr></thead><tbody><% for(const movement of movements) { %><tr><td><%= when(movement.created_at) %></td><td><%= movement.name %></td><td><%= movement.delta_milli>=0?'+':'' %><%= stock(movement.delta_milli) %> <%= movement.unit %></td><td><%= movement.reason %></td></tr><% } %></tbody></table><% if(!movements.length) { %><p class="muted">No adjustments recorded yet.</p><% } %></div></section>
<%- include('partials/footer') %>
