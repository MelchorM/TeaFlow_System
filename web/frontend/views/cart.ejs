<%- include('partials/header', {title}) %>
<div class="page-heading"><p class="eyebrow">A CUP OF SOMETHING GOOD</p><h1>Your cart</h1><p>Review your drinks before placing your order.</p></div>
<% if(!items.length) { %><div class="empty-state"><span class="empty-symbol">B</span><h2>Your next favorite is waiting.</h2><p>Your cart is empty. Explore the menu to find your brew.</p><a class="button" href="/">Explore the menu</a></div><% } else { %>
<div class="checkout-layout"><section class="cart-lines"><% items.forEach((item,index) => { %><article class="panel cart-line"><div><h3><%= item.product_name %></h3><p><%= item.quantity %> × <%= item.size %> · <%= item.sugar %>% sugar · <%= item.ice %> ice</p><p class="muted"><%= item.addons.map(a=>a.name).join(', ') || 'No extra toppings' %></p><% if(item.error) { %><p class="error-text"><%= item.error %></p><% } %></div><div class="cart-line-end"><strong><%= money(item.unit_cents*item.quantity) %></strong><form action="/cart/<%= index %>/remove" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" type="submit">Remove</button></form></div></article><% }); %><a href="/" class="back-link">← Add another drink</a></section>
<aside class="panel checkout-panel"><h2>Order summary</h2><div class="total-row"><span>Total</span><strong><%= money(total) %></strong></div><p class="muted">Pickup at BESTBREW. The cashier will check and confirm your payment before preparation starts.</p>
  <% if(!available) { %><div class="notice warning">Remove unavailable items to continue.</div><% } else if(!user) { %><a href="/login" class="button full">Sign in to order</a><p class="auth-alternate">No account yet? <a href="/register">Create one</a></p><% } else { %>
  <form action="/checkout" method="post" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><input type="hidden" name="quoted_total_cents" value="<%= total %>"><label>Name for the order<input class="form-control" name="customer_name" value="<%= user.role==='customer'?user.name:'' %>" maxlength="80" autocomplete="name" required></label><button class="button full" type="submit">Place order <span>↗</span></button></form><% } %>
</aside></div><% } %>
<%- include('partials/footer') %>
