<%- include('partials/header', {title}) %>
<div class="page-heading heading-with-action"><div><p class="eyebrow"><%= customerView?'YOUR BESTBREW HISTORY':'CASHIER WORKSPACE' %></p><h1><%= title %></h1><p><%= customerView?'Your recent orders and their progress.':'Verify payment before sending an order to the kitchen.' %></p></div>
<% if(!customerView) { %><form method="post" action="/staff/walk-in"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button" type="submit">+ Walk-in order</button></form><% } %></div>
<% if(!customerView) { %><div class="category-tabs"><a class="category-tab <%= !history?'selected':'' %>" href="/staff/orders">Active orders</a><a class="category-tab <%= history?'selected':'' %>" href="/staff/orders?history=1">Completed orders</a></div><% } %>
<section id="orders-panel" <%- !history?'data-poll="orders-panel"':'' %> class="order-grid">
<% if(!customerView && low.length) { %><div class="notice warning">Low stock: <%= low.map(i=>i.name).join(', ') %></div><% } %>
<% if(!orders.length) { %><div class="empty-state"><h2>No orders here yet.</h2><p><%= history?'Completed orders will appear here.':'New orders will appear here automatically.' %></p></div><% } %>
<% for(const order of orders) { %><article class="panel order-card"><div class="order-card-heading"><h2><%= order.code %></h2><%- include('partials/badge', {status:order.status}) %></div><p class="order-person"><%= order.customer_name %> <span class="source-tag"><%= order.source==='web'?'Website':'Walk-in' %></span></p><p class="muted"><%= when(order.created_at) %></p><%- include('partials/items',{order}) %><div class="total-row"><span>Total</span><strong><%= money(order.total_cents) %></strong></div>
<% if(customerView) { %><a class="button secondary full" href="/orders/<%= order.tracking_token %>">View order</a><% } else if(order.status==='unpaid') { %><form method="post" action="/staff/orders/<%= order.id %>/pay" data-confirm="Confirm that you have checked and received this customer’s payment?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button full" type="submit">Confirm payment</button></form><% } else if(order.status==='ready') { %><form method="post" action="/staff/orders/<%= order.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="completed"><button class="button full" type="submit">Complete handover</button></form><% } %>
</article><% } %>
</section><% if(!history) { %><p class="sync-status" role="status">Checking for updates…</p><% } %>
<%- include('partials/footer') %>
