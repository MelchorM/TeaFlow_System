        <div class='page-wrap'><div class='page-label'>Report Page 1</div><img src='data:image/png;base64,' alt='Best Brew Report Page 1' /></div><div class='page-wrap'><div class='page-label'>Report Page 2</div><img src='data:image/png;base64,' alt='Best Brew Report Page 2' /></div><div class='page-wrap'><div class='page-label'>Report Page 3</div><img src='data:image/png;base64,' alt='Best Brew Report Page 3' /></div>
