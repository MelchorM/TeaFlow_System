<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Best Brew Admin Report</title>
<style>
body {
    font-family: Arial, sans-serif;
    background: #f7efe6;
    margin: 0;
    padding: 24px;
    color: #4a2a18;
}
.doc-shell {
    max-width: 1220px;
    margin: 0 auto;
}
.doc-title {
    font-size: 26px;
    font-weight: 800;
    margin-bottom: 4px;
}
.doc-subtitle {
    font-size: 13px;
    color: #7a5a45;
    margin-bottom: 8px;
}
.doc-meta {
    font-size: 12px;
    color: #7a5a45;
    margin-bottom: 18px;
}
.page-wrap {
    background: #fffaf5;
    border: 1px solid #ead5c4;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 18px;
}
.page-label {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #6a391a;
}
img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
}
</style>
</head>
<body>
    <div class="doc-shell">
        <div class="doc-title">Best Brew Admin Report</div>
        <div class="doc-subtitle">Embedded image report for Word document viewing</div>
